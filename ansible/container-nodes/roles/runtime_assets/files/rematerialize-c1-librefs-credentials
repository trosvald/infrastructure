#!/usr/bin/env bash
set -euo pipefail

DOCKER_BIN="${DOCKER_BIN:-docker}"
CURL_BIN="${CURL_BIN:-curl}"
JQ_BIN="${JQ_BIN:-jq}"
GIT_BIN="${GIT_BIN:-git}"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
SLEEP_BIN="${SLEEP_BIN:-sleep}"
STAT_BIN="${STAT_BIN:-stat}"
CONTROLLER_GATE="${CONTROLLER_GATE:-/usr/local/sbin/check-c1-doco-controller}"
DATA_ROOT="${DATA_ROOT:-/var/lib/docker/volumes/doco-cd-c1-data/_data}"
API_SECRET_FILE="${API_SECRET_FILE:-/opt/doco-cd/secrets/api_secret}"
readonly DOCKER_BIN CURL_BIN JQ_BIN GIT_BIN SYSTEMCTL_BIN SLEEP_BIN STAT_BIN
readonly CONTROLLER_GATE DATA_ROOT API_SECRET_FILE
readonly REMOTE_URL=https://github.com/trosvald/infrastructure.git
readonly REPOSITORY_ROOT="$DATA_ROOT/github.com/trosvald/infrastructure"
readonly SERVICES=(doco-project-librefs-c1.service doco-project-edge-c1.service doco-project-forgejo-c1.service)
readonly CORE_CONTAINERS=(librefs-c1 haproxy-c1 crowdsec-c1 crowdsec-spoa-c1 vector-c1 forgejo-c1 forgejo-postgres-c1 kopia-forgejo-c1)
source_name="c1-secret-rematerialize-$$"
source_root="$DATA_ROOT/$source_name"
cache_root="$DATA_ROOT/data/$source_name"
services_stopped=false
librefs_removed=false
normalization_verified=false
fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
cleanup() {
    local rc=$? service
    trap - EXIT
    rm -rf "$source_root" "$cache_root"
    if [[ "$librefs_removed" == true && "$normalization_verified" == false ]] \
       && "$DOCKER_BIN" container inspect librefs-c1 >/dev/null 2>&1; then
        "$DOCKER_BIN" rm -f librefs-c1 >/dev/null 2>&1 \
            || printf 'ERROR: failed to remove unverified rematerialized libreFS container\n' >&2
    fi
    if [[ "$services_stopped" == true ]]; then
        for service in "${SERVICES[@]}"; do
            "$SYSTEMCTL_BIN" start "$service" >/dev/null 2>&1 \
                || printf 'ERROR: failed to restore %s after rematerialization failure\n' "$service" >&2
        done
    fi
    exit "$rc"
}
trap cleanup EXIT

[[ "${FAKE_UID:-$(id -u)}" == 0 ]] || fail 'must run as root'
[[ -f "$API_SECRET_FILE" && ! -L "$API_SECRET_FILE" ]] || fail 'Doco API secret file is missing or unsafe'
[[ "$("$STAT_BIN" -c '%U:%G:%a' "$API_SECRET_FILE")" == root:root:600 ]] || fail 'Doco API secret file must be root:root mode 0600'
[[ -d "$REPOSITORY_ROOT/.git" ]] || fail 'Doco main repository checkout is missing'
"$CONTROLLER_GATE" >/dev/null || fail 'Doco controller/provider preflight failed before rematerialization'
IFS= read -r api_secret <"$API_SECRET_FILE"
[[ -n "$api_secret" && "$api_secret" != *[$'\t\r\n ']* ]] || fail 'Doco API secret file is invalid'

poll() {
    local payload="$1" response job_id
    exec 3<<<"header = \"x-api-key: $api_secret\""
    response="$(printf '%s\n' "$payload" | "$CURL_BIN" --silent --show-error --fail-with-body --proto '=http' \
        --config /dev/fd/3 --header 'Content-Type: application/json' --request POST --data-binary @- \
        'http://127.0.0.1:8080/v1/api/poll/run?wait=true')" || fail 'Doco poll request failed'
    exec 3<&-
    job_id="$("$JQ_BIN" -er '.job_id' <<<"$response")" || fail 'Doco poll returned no job identifier'
    unset response
    exec 3<<<"header = \"x-api-key: $api_secret\""
    "$CURL_BIN" --silent --show-error --fail-with-body --proto '=http' --config /dev/fd/3 \
        "http://127.0.0.1:8080/v1/api/run/$job_id" | "$JQ_BIN" -e '.content.status == "succeeded"' >/dev/null \
        || fail 'Doco poll did not succeed'
    exec 3<&-
}
wait_healthy() {
    local container="$1" attempt state health
    for attempt in $(seq 1 120); do
        if "$DOCKER_BIN" inspect "$container" >/dev/null 2>&1; then
            state="$("$DOCKER_BIN" inspect "$container" --format '{{.State.Status}}')"
            health="$("$DOCKER_BIN" inspect "$container" --format '{{if .State.Health}}{{.State.Health.Status}}{{end}}')"
            if [[ "$state" == running && ( -z "$health" || "$health" == healthy ) ]]; then return 0; fi
        fi
        "$SLEEP_BIN" 1
    done
    return 1
}

rm -rf "$source_root" "$cache_root"
"$GIT_BIN" clone --quiet --no-hardlinks "$REPOSITORY_ROOT" "$source_root"
"$GIT_BIN" -C "$source_root" checkout --quiet -b c1-secret-rematerialize origin/main
cat >"$source_root/docker/c1/librefs/.doco-cd.rotation.yaml" <<'YAML'
---
name: librefs-c1
force_recreate: true
external_secrets:
  LIBREFS_ROOT_USER: kv:kv:docker/c1/librefs:root_user
  LIBREFS_ROOT_PASSWORD: kv:kv:docker/c1/librefs:root_password
YAML
cat >"$source_root/docker/c1/edge/.doco-cd.rotation.yaml" <<'YAML'
---
name: edge-c1
compose_files: [compose.yml]
force_recreate: true
YAML
cat >"$source_root/docker/c1/forgejo/.doco-cd.rotation.yaml" <<'YAML'
---
name: forgejo-c1
compose_files: [compose.yml]
force_recreate: true
YAML
chmod 0600 "$source_root"/docker/c1/{librefs,edge,forgejo}/.doco-cd.rotation.yaml
"$GIT_BIN" -C "$source_root" add docker/c1/librefs/.doco-cd.rotation.yaml docker/c1/edge/.doco-cd.rotation.yaml docker/c1/forgejo/.doco-cd.rotation.yaml
"$GIT_BIN" -C "$source_root" -c user.name=c1-secret-rematerialize -c user.email=local-only.invalid commit --quiet -m 'local-only c1 secret rematerialization'
revision="$("$GIT_BIN" -C "$source_root" rev-parse HEAD)"
local_payload="$("$JQ_BIN" -cn --arg url "file:///data/$source_name" --arg reference "$revision" '[{url:$url,reference:$reference,target:"rotation",interval:"180s",watch:false}]')"
unset revision
for service in "${SERVICES[@]}"; do "$SYSTEMCTL_BIN" stop "$service"; done
services_stopped=true
if "$DOCKER_BIN" container inspect librefs-c1 >/dev/null 2>&1; then
    "$DOCKER_BIN" rm -f librefs-c1 >/dev/null || fail 'failed to remove prior stateless libreFS container'
    librefs_removed=true
fi
poll "$local_payload"
unset local_payload
poll '[{"url":"https://github.com/trosvald/infrastructure.git","reference":"refs/heads/main","interval":"180s","watch":false}]'
unset api_secret
for container in "${CORE_CONTAINERS[@]}"; do
    wait_healthy "$container" || fail "$container did not become healthy after Doco rematerialization"
    [[ "$("$DOCKER_BIN" inspect "$container" --format '{{index .Config.Labels "cd.doco.source.url"}}')" == "$REMOTE_URL" ]] \
        || fail "$container Doco provenance did not normalize to remote main"
done
normalization_verified=true
for service in "${SERVICES[@]}"; do "$SYSTEMCTL_BIN" start "$service"; done
services_stopped=false
printf 'Doco rematerialized exact c1 project allowlist and normalized remote-main provenance\n'
