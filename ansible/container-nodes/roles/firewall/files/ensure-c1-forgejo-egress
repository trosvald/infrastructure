#!/usr/bin/env bash
set -euo pipefail
NFT_BIN="${NFT_BIN:-nft}"; PYTHON_BIN="${PYTHON_BIN:-python3}"; ID_BIN="${ID_BIN:-id}"; POLICY="${POLICY:-/etc/nftables.d/monosense-c1-forgejo-egress.nft}"
fail(){ printf 'ERROR: %s\n' "$*" >&2; exit 1; }
validate(){ "$PYTHON_BIN" -c 'import json,sys
j=json.loads(sys.argv[1]); text=" ".join(sys.argv[2].split()); labeled=sys.argv[3]=="labeled"; objs=[x for x in j.get("nftables",[]) if "metainfo" not in x]
comments={next(iter(x.values())).get("comment") for x in objs}; expected={"monosense:forgejo-egress:v1:table","monosense:forgejo-egress:v1:denied-v4","monosense:forgejo-egress:v1:forward",*{"monosense:forgejo-egress:v1:r%d"%i for i in range(1,9)}}
need=["ip saddr 172.30.15.67 ip daddr 10.25.13.65 tcp dport 443 accept", "ip saddr 172.30.15.66 ip daddr 10.25.20.41 tcp dport 6379 accept", "ip saddr { 172.30.15.66, 172.30.15.67 } ip daddr @denied_v4 drop", "ip saddr { 172.30.15.66, 172.30.15.67 } udp dport 53 accept", "ip saddr { 172.30.15.66, 172.30.15.67 } tcp dport { 53, 443 } accept", "ip saddr 172.30.15.66 tcp dport 587 accept", "ip saddr { 172.30.15.66, 172.30.15.67 } drop"]
tables=[x["table"] for x in objs if "table" in x];sets=[x["set"] for x in objs if "set" in x];chains=[x["chain"] for x in objs if "chain" in x];rules=[x["rule"] for x in objs if "rule" in x]
comment_ok=comments==expected if labeled else comments=={None}
state_ok=("ct state established,related accept" in text or "ct state 0x2,0x4 accept" in text)
ok=(comment_ok and state_ok and len(objs)==11 and len(tables)==len(sets)==len(chains)==1 and len(rules)==8 and tables[0].get("family")=="inet" and tables[0].get("name")=="c1_forgejo_egress" and sets[0].get("name")=="denied_v4" and sets[0].get("type")=="ipv4_addr" and sets[0].get("flags")==["interval"] and chains[0].get("name")=="forward" and chains[0].get("hook")=="forward" and chains[0].get("prio")==-5 and chains[0].get("policy")=="accept" and all(v in text for v in need))
raise SystemExit(0 if ok else 1)' "$1" "$2" "$3"; }
mode="${1:-check}"; [[ $# -le 1 && ( "$mode" == check || "$mode" == apply ) ]] || fail 'usage: ensure-c1-forgejo-egress [check|apply]'; [[ "$("$ID_BIN" -u)" == 0 ]] || fail 'root required'
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT; error="$work/error"; transaction="$work/transaction"
set +e; json="$("$NFT_BIN" -j list table inet c1_forgejo_egress 2>"$error")"; status=$?; set -e
if (( status==0 )); then
 text="$("$NFT_BIN" -nn list table inet c1_forgejo_egress)"
 if validate "$json" "$text" labeled; then printf 'Forgejo egress table exact contract matches\n'; exit; fi
 validate "$json" "$text" legacy || fail 'repository-owned Forgejo egress table has critical drift; refusing replacement'
 [[ "$mode" == apply ]] || { printf 'Exact legacy Forgejo egress table would be atomically labeled\n'; exit; }
 { printf '%s\n' 'delete table inet c1_forgejo_egress'; cat "$POLICY"; } >"$transaction"
 "$NFT_BIN" -c -f "$transaction" || fail 'legacy-label transaction syntax check failed'
 "$NFT_BIN" -f "$transaction" || fail 'failed to atomically label exact legacy table'
 json="$("$NFT_BIN" -j list table inet c1_forgejo_egress)"; text="$("$NFT_BIN" -nn list table inet c1_forgejo_egress)"
 validate "$json" "$text" labeled || fail 'atomically labeled Forgejo egress table failed verification'
 printf 'Exact legacy Forgejo egress table atomically labeled\n'; exit
fi
all="$("$NFT_BIN" list tables)" || fail 'cannot distinguish absent table from nftables failure'; [[ "$all" != *'table inet c1_forgejo_egress'* ]] || fail "failed to inspect existing table: $(<"$error")"
"$NFT_BIN" -c -f "$POLICY" || fail 'policy syntax check failed'; [[ "$mode" == apply ]] || { printf 'Forgejo egress table absent; apply would create it\n'; exit; }
"$NFT_BIN" -f "$POLICY" || fail 'failed to create repository-owned table'; json="$("$NFT_BIN" -j list table inet c1_forgejo_egress)"; text="$("$NFT_BIN" -nn list table inet c1_forgejo_egress)"; validate "$json" "$text" labeled || fail 'created Forgejo egress table failed verification'
