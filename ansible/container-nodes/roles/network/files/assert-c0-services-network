try:
 x=n[0];e=sorted((v.get("Name"),v.get("IPv4Address"),v.get("IPv6Address","")) for v in x.get("Containers",{}).values());ok=(len(n)==1 and x["Name"]=="c0_services" and x["Driver"]=="ipvlan" and x["Scope"]=="local" and x["EnableIPv4"] is True and x["EnableIPv6"] is False and x["Internal"] is False and x["Attachable"] is False and x["Ingress"] is False and x["ConfigOnly"] is False and x["IPAM"]["Driver"]=="default" and x["IPAM"].get("Options",{})=={} and x["IPAM"]["Config"]==[{"Subnet":"10.25.13.0/24","Gateway":"10.25.13.1"}] and x["Options"]=={"parent":"enp0s31f6.2513","ipvlan_mode":"l2","ipvlan_flag":"bridge","com.docker.network.driver.mtu":"1496"} and x["Labels"]=={} and len(e)==len(set(e)) and set(e).issubset(set(expected)))
except (IndexError,KeyError,TypeError,ValueError):ok=False
