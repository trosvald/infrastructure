---
apiVersion: v1alpha1
kind: LinkConfig
name: {{ node.bootstrap_link }}
up: true
mtu: 1496
addresses:
  - address: {{ node.bootstrap_address }}/24
routes:
  - gateway: {{ topology.network.gateway }}
    metric: 2048
---
apiVersion: v1alpha1
kind: BondConfig
name: bond0
hardwareAddr: "{{ node.links.tor1.permanent_mac }}"
links:
  - enp1s0f0np0
  - enp1s0f1np1
bondMode: active-backup
arpInterval: 1000
arpIpTargets:
  - {{ topology.network.gateway }}
arpValidate: active
arpAllTargets: all
primaryReselect: failure
numPeerNotif: 3
addresses:
  - address: {{ node.address }}/24
routes:
  - gateway: {{ topology.network.gateway }}
    metric: 1024
mtu: 1496
---
apiVersion: v1alpha1
kind: ResolverConfig
hostDNS:
  enabled: true
  forwardKubeDNSToHost: true
  resolveMemberNames: true
nameservers:
{% for nameserver in topology.private_dns %}
  - address: {{ nameserver }}
{% endfor %}
searchDomains:
  domains:
    - monosense.io
---
apiVersion: v1alpha1
kind: TimeSyncConfig
ntp:
  servers:
{% for server in topology.ntp_servers %}
    - {{ server }}
{% endfor %}
