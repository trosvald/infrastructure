#!/bin/sh
set -eu
PATH=/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/usr/local/libexec/llmkube
root=/var/lib/llmkube
work="$(mktemp -d "$root/.sync.XXXXXX")"
cleanup() { rm -rf "$work"; }
trap cleanup EXIT HUP INT TERM
chmod 0700 "$work"
get_secret() {
    namespace="$1" secret="$2" key="$3" output="$4"
    value="$(kubectl --kubeconfig "$root/kubeconfig" -n "$namespace" get secret "$secret" -o "jsonpath={.data.$key}")"
    test -n "$value"
    printf '%s' "$value" | base64 -D >"$work/$output"
}
get_secret ai llmkube-mac-tls 'tls\.crt' llmkube-mac-tls-tls.crt
get_secret ai llmkube-mac-tls 'tls\.key' llmkube-mac-tls-tls.key
get_secret ai llmkube-mac-tls 'ca\.crt' llmkube-mac-tls-ca.crt
get_secret ai llmkube-embedding-api-key api-key llmkube-embedding-api-key-api-key
get_secret ai mac-embedding-client-tls 'ca\.crt' mac-embedding-client-tls-ca.crt
chmod 0600 "$work"/*
tar -C "$work" -cf - . | /usr/local/libexec/llmkube/install-generation
trap - EXIT HUP INT TERM
rm -rf "$work"
