{
    admin off
    auto_https off
}
embedding.internal:8443, qwen3-embedding-tls.ai.svc.cluster.local:8443 {
    tls /var/lib/llmkube/current/tls.crt /var/lib/llmkube/current/tls.key
    @embedding path /v1/embeddings /health /healthz
    handle @embedding {
        reverse_proxy 127.0.0.1:8081
    }
    respond 404
}
mac-metrics.internal:9443 {
    tls /var/lib/llmkube/current/tls.crt /var/lib/llmkube/current/tls.key {
        client_auth {
            mode require_and_verify
            trust_pool file /var/lib/llmkube/current/vmagent-client-ca.crt
        }
    }
    handle /metrics {
        reverse_proxy 127.0.0.1:9090
    }
    respond 404
}
