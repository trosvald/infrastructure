$ORIGIN monosense.io.
$TTL 300
@ 300 IN SOA ns1.monosense.io. hostmaster.monosense.io. (
  2026090201 ; serial
  3600       ; refresh
  600        ; retry
  604800     ; expire
  300        ; minimum
)
@ 300 IN NS ns1.monosense.io.
c0 300 IN A 10.25.10.20
adguard 300 IN A 10.25.10.100
c1 300 IN A 10.25.10.101
k1 300 IN A 10.25.11.11
k2 300 IN A 10.25.11.12
k3 300 IN A 10.25.11.13
k4 300 IN A 10.25.11.14
k5 300 IN A 10.25.11.15
k8s 300 IN A 10.25.20.10
ns1 300 IN A 10.25.13.33
vault 300 IN A 10.25.13.34
edge 300 IN A 10.25.15.10
git 300 IN A 10.25.15.10
s3 300 IN A 10.25.13.65
status 300 IN A 10.25.13.36
logs-ingest 300 IN A 10.25.13.37
