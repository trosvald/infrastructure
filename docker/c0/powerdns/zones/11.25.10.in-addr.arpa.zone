$ORIGIN 11.25.10.in-addr.arpa.
$TTL 300
@ 300 IN SOA ns1.monosense.io. hostmaster.monosense.io. (
  2026082501 ; serial
  3600       ; refresh
  600        ; retry
  604800     ; expire
  300        ; minimum
)
@ 300 IN NS ns1.monosense.io.
11 300 IN PTR k1.monosense.io.
12 300 IN PTR k2.monosense.io.
13 300 IN PTR k3.monosense.io.
14 300 IN PTR k4.monosense.io.
15 300 IN PTR k5.monosense.io.
