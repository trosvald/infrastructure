# Install beside the existing bond0.2512 and bond0.2513 stanzas only after review.
# bond0 itself is operator-owned active-backup across tor1 and tor2; this file does not alter it.
auto bond0.2515
iface bond0.2515 inet manual
    vlan-raw-device bond0
    mtu 1496
    pre-up /bin/sh -c 'printf 1 > /proc/sys/net/ipv6/conf/"$IFACE"/disable_ipv6'
    post-up /usr/sbin/ip -6 address flush dev $IFACE scope link
