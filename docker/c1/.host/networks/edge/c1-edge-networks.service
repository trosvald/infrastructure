[Unit]
Description=Ensure exact c1 EDGE and Forgejo frontend Docker networks
Requires=docker.service
After=docker.service network-online.target sys-subsystem-net-devices-bond0.2515.device
Wants=network-online.target
Before=doco-cd-c1.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ensure-c1-edge-networks apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
