[Unit]
Description=Renew the c1 Doco-CD OpenBao token
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/renew-c1-openbao-token
SyslogIdentifier=doco-c1-openbao-renew
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/opt/doco-cd/secrets/openbao-token
