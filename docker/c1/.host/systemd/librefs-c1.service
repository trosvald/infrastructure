[Unit]
Description=Start c1 libreFS after verified storage and network prerequisites
Requires=docker.service c1-librefs-storage.service c1-services-shim.service
After=docker.service c1-librefs-storage.service c1-services-shim.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=/usr/local/sbin/assert-c1-mount librefs /srv/librefs
ExecStart=/usr/local/sbin/manage-c1-librefs start
ExecStop=/usr/local/sbin/manage-c1-librefs stop
RemainAfterExit=yes
TimeoutStartSec=90s
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
